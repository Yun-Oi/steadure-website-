---
import '../styles/steadure.css';
import { siteConfig } from '../data/siteData.js';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Steadure — build to keep you moving.",
  description = "Steadure turns one finance-education YouTube video into: 2-3 X posts/threads, 1 LinkedIn post, 1 newsletter, 1 email letter."
} = Astro.props;

// JSON-LD Structured Data
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "name": "Steadure",
      "url": "https://steadure.com",
      "logo": "https://steadure.com/og-image.png",
      "email": "contact@steadure.com",
      "sameAs": [
        "https://x.com/steadure",
        "https://linkedin.com/company/steadure"
      ]
    },
    {
      "@type": "Service",
      "name": "Finance Content Repurposing",
      "provider": {
        "@type": "Organization",
        "name": "Steadure"
      },
      "description": "Steadure turns one finance-education YouTube video into threads, posts, a newsletter and an email letter.",
      "areaServed": "Global"
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href="https://steadure.com/" />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F4EFE6" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://steadure.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://steadure.com/og-image.png" />
    <meta property="og:site_name" content="Steadure" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://steadure.com/og-image.png" />

    <!-- Preload Critical Local Fonts -->
    <link rel="preload" href="/fonts/fraunces-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/newsreader-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/courier-prime-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/caveat-600.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Fallback Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Courier+Prime:wght@400;700&family=Fraunces:opsz,wght@9..144,700&family=Newsreader:opsz,wght@6..72,400&display=swap" rel="stylesheet" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </head>
  <body>
    <!-- Zero custom-cursor artifacts, zero floating pills -->
    <slot />
  </body>
</html>

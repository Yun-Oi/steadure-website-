---
import { siteConfig } from '../data/siteData.js';
---

<section id="contact" class="contact-section">
  <div class="container-zine">
    <!-- Header -->
    <div class="contact-ledger-header">
      <span class="stamp-badge">08 // INTAKE PROTOCOL</span>
      <span class="type-mono-sm">NO CALENDLY // ZERO WASTED MEETINGS</span>
    </div>

    <!-- The Paper Intake Form Voucher -->
    <div class="intake-voucher card-elevated">
      <div class="tape-strip tape-corner-left"></div>
      <div class="tape-strip tape-corner-right"></div>

      <!-- Voucher Masthead -->
      <div class="voucher-top-bar">
        <div class="voucher-title-wrap">
          <span class="voucher-id type-mono-sm">FORM_ID // ST-2026-INTAKE</span>
          <h2 class="voucher-heading type-punch-lg">SEND US ONE VIDEO.</h2>
        </div>
        <div class="voucher-stamp-badge">
          <span class="stamp-badge">PILOT AUDIT: FREE</span>
        </div>
      </div>

      <p class="voucher-subhead type-serif-body">
        Drop your YouTube link below. Within 48 hours, our editorial desk will return a 3-part sample pack written in your voice. If you love it, we talk. If not, the writing is yours to keep.
      </p>

      <!-- Form Grid -->
      <form class="intake-form" id="creatorIntakeForm" onsubmit="event.preventDefault(); window.handleVoucherSubmit();">
        <div class="form-fields-grid">
          <!-- Field 1: Name -->
          <div class="form-field">
            <label for="creatorName" class="input-label">
              01. CREATOR / CHANNEL NAME <span class="req-star">*</span>
            </label>
            <input 
              type="text" 
              id="creatorName" 
              name="creatorName" 
              class="input-raw" 
              placeholder="e.g. The 1% Club // Ankit" 
              required 
            />
            <span class="input-helper">The name you publish under.</span>
          </div>

          <!-- Field 2: Email -->
          <div class="form-field">
            <label for="creatorEmail" class="input-label">
              02. YOUR WORK EMAIL <span class="req-star">*</span>
            </label>
            <input 
              type="email" 
              id="creatorEmail" 
              name="creatorEmail" 
              class="input-raw" 
              placeholder="creator@yourdomain.com" 
              required 
            />
            <span class="input-helper">Where we send the completed Notion docket.</span>
          </div>

          <!-- Field 3: Channel Link -->
          <div class="form-field">
            <label for="channelLink" class="input-label">
              03. YOUTUBE CHANNEL LINK <span class="req-star">*</span>
            </label>
            <input 
              type="url" 
              id="channelLink" 
              name="channelLink" 
              class="input-raw" 
              placeholder="https://youtube.com/@yourchannel" 
              required 
            />
            <span class="input-helper">Used to study your historical pacing and tone.</span>
          </div>

          <!-- Field 4: Video Link -->
          <div class="form-field">
            <label for="videoLink" class="input-label">
              04. TEST VIDEO URL [PUBLIC OR UNLISTED] <span class="req-star">*</span>
            </label>
            <input 
              type="url" 
              id="videoLink" 
              name="videoLink" 
              class="input-raw" 
              placeholder="https://youtu.be/... or drive link" 
              required 
            />
            <span class="input-helper">The one video you want translated into text assets.</span>
          </div>

          <!-- Field 5: Notes / Target Audience -->
          <div class="form-field full-width">
            <label for="editorialNotes" class="input-label">
              05. EDITORIAL NOTES & TARGET READERS [OPTIONAL]
            </label>
            <textarea 
              id="editorialNotes" 
              name="editorialNotes" 
              rows="3" 
              class="input-raw textarea-raw" 
              placeholder="e.g. Focus on high-income engineers; emphasize the mathematical proofs over generic budgeting..."
            ></textarea>
            <span class="input-helper">Any specific claims to double-check or platform priorities.</span>
          </div>
        </div>

        <!-- Submit Bar -->
        <div class="form-action-bar">
          <button type="submit" class="btn-primary form-submit-btn" id="submitVoucherBtn">
            DISPATCH VIDEO TO EDITORIAL DESK [SUBMIT]
          </button>
          <span class="action-note type-mono-sm">
            48-HOUR STRICT TURNAROUND // ZERO SPAM GUARANTEED
          </span>
        </div>

        <!-- Success Confirmation Message (Hidden Initially) -->
        <div class="voucher-success-card card-raw" id="voucherSuccessMsg" style="display: none;">
          <div class="success-top-bar">
            <span class="stamp-badge-green">RECEIPT ISSUED // DISPATCH CONFIRMED</span>
            <span class="type-mono-sm" id="voucherReceiptNum">REF: ST-9941</span>
          </div>
          <p class="type-punch-md success-heading">YOUR VIDEO IS ON THE EDITORIAL DESK.</p>
          <p class="type-serif-body">
            We have registered your submission. Our senior editors are analyzing the transcript, excavating the strongest hooks, and calibrating your voice. Expect your test docket within 48 hours.
          </p>
        </div>
      </form>

      <!-- Direct Contact Ledger -->
      <div class="direct-contact-ledger">
        <div class="ledger-col">
          <span class="col-title type-mono-sm">DIRECT INBOX:</span>
          <a href={`mailto:${siteConfig.email}`} class="direct-link type-punch-md link-ghost">
            {siteConfig.email}
          </a>
        </div>

        <div class="ledger-col">
          <span class="col-title type-mono-sm">CREATOR TELEGRAPH:</span>
          <div class="social-tags-row">
            <a href={siteConfig.socials.x} target="_blank" rel="noopener" class="btn-stamp social-btn">
              X // @STEADURE
            </a>
            <a href={siteConfig.socials.linkedin} target="_blank" rel="noopener" class="btn-stamp social-btn">
              LINKEDIN // STEADURE
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  declare global {
    interface Window {
      handleVoucherSubmit: () => void;
    }
  }

  window.handleVoucherSubmit = function() {
    const btn = document.getElementById('submitVoucherBtn') as HTMLButtonElement | null;
    const successCard = document.getElementById('voucherSuccessMsg');
    const receiptNum = document.getElementById('voucherReceiptNum');

    if (btn) {
      btn.innerText = "TRANSMITTING TO DESK...";
      btn.disabled = true;
    }

    setTimeout(() => {
      if (btn) btn.style.display = 'none';
      if (successCard) {
        successCard.style.display = 'block';
        if (receiptNum) {
          receiptNum.innerText = `REF: ST-${Math.floor(1000 + Math.random() * 9000)}`;
        }
      }
    }, 600);
  };
</script>

<style>
  .contact-section {
    padding-top: var(--sp-6);
    padding-bottom: var(--sp-8);
    background-color: var(--paper-base);
    border-bottom: var(--border-thick);
  }

  .contact-ledger-header {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-bottom: var(--sp-4);
  }

  .intake-voucher {
    background-color: var(--paper-sheet);
    border: var(--border-heavy);
    padding: clamp(24px, 5vw, 56px);
    position: relative;
    max-width: 1040px;
    margin-left: auto;
    margin-right: auto;
  }

  .voucher-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom: 2px dashed var(--ink-black);
    padding-bottom: 16px;
    margin-bottom: 16px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .voucher-id {
    color: var(--accent-vermilion);
    font-weight: 700;
    display: block;
    margin-bottom: 4px;
  }

  .voucher-heading {
    color: var(--ink-black);
  }

  .voucher-subhead {
    max-width: 820px;
    font-size: 1.15rem;
    color: var(--ink-secondary);
    margin-bottom: var(--sp-5);
  }

  /* Form Fields */
  .form-fields-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-4);
    margin-bottom: var(--sp-4);
  }

  @media (min-width: 768px) {
    .form-fields-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-field {
    display: flex;
    flex-direction: column;
  }

  .form-field.full-width {
    grid-column: 1 / -1;
  }

  .req-star {
    color: var(--accent-vermilion);
  }

  .textarea-raw {
    resize: vertical;
    min-height: 90px;
  }

  .form-action-bar {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    margin-top: var(--sp-4);
    border-top: var(--border-thick);
    padding-top: var(--sp-4);
  }

  @media (min-width: 640px) {
    .form-action-bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .form-submit-btn {
    padding: 14px 32px;
  }

  .action-note {
    color: var(--ink-muted);
    font-weight: 700;
  }

  /* Success Card */
  .voucher-success-card {
    background-color: #F8FFF4;
    border: 3px solid var(--accent-success);
    padding: 24px;
    margin-top: 20px;
    animation: fadeInVoucher 0.3s ease forwards;
  }

  @keyframes fadeInVoucher {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .success-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px dashed var(--accent-success);
    padding-bottom: 8px;
    margin-bottom: 12px;
  }

  .success-heading {
    color: var(--accent-success);
    margin-bottom: 8px;
  }

  /* Direct Contact Ledger */
  .direct-contact-ledger {
    margin-top: var(--sp-6);
    border-top: var(--border-thick);
    padding-top: var(--sp-4);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-4);
  }

  @media (min-width: 768px) {
    .direct-contact-ledger {
      grid-template-columns: 1fr 1fr;
    }
  }

  .ledger-col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .col-title {
    color: var(--ink-muted);
    font-weight: 700;
  }

  .direct-link {
    font-size: 1.15rem;
  }

  .social-tags-row {
    display: flex;
    gap: var(--sp-2);
    flex-wrap: wrap;
  }

  .social-btn {
    font-size: 0.75rem;
    padding: 6px 14px;
  }
</style>

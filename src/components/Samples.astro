---
import { sampleData, siteConfig } from '../data/siteData.js';
---

<section class="samples-section" id="samples" aria-labelledby="samples-heading">
  <div class="container">
    
    <div class="samples-header">
      <h2 id="samples-heading" class="samples-title">
        {sampleData.title}
      </h2>
      <p class="typewriter-disclaimer">
        {sampleData.disclaimer}
      </p>
    </div>

    <!-- Main Interactive Demo Layout -->
    <div class="demo-layout">
      
      <!-- LEFT PANEL: Film Strip / Transcript (Spoken-style lines) -->
      <aside class="transcript-column" aria-label="Spoken video transcript excerpts">
        <div class="transcript-paper">
          <div class="tape-strip" aria-hidden="true"></div>
          
          <div class="transcript-top">
            <span class="typewriter-label">VIDEO TRANSCRIPT</span>
            <span class="transcript-track-label">The 1% Club: AICFO Launch</span>
          </div>

          <div class="transcript-lines" id="transcriptLines">
            {sampleData.transcriptLines.map((line) => (
              <div 
                class="transcript-line" 
                id={'line-' + line.id} 
                data-active-for={line.activeFor.join(',')}
              >
                <span class="line-timestamp">{line.time}</span>
                <p class="line-text">"{line.text}"</p>
              </div>
            ))}
          </div>

          <div class="transcript-footer">
            <span class="typewriter-label">Sample transcript · Spoken video</span>
          </div>
        </div>
      </aside>

      <!-- RIGHT PANEL: 4 Illustrated Tabs & Realistic Platform Mockups -->
      <div class="mockup-column">
        
        <!-- Tab Bar -->
        <div class="tab-bar-container">
          <div class="tab-buttons" role="tablist" aria-label="Output platform tabs">
            <button class="tab-btn active" role="tab" aria-selected="true" data-tab="x" id="tab-x">
              <svg viewBox="0 0 20 20" class="tab-icon" aria-hidden="true">
                <path d="M 4 4 L 16 16 M 16 4 L 4 16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
              </svg>
              <span>X Thread</span>
            </button>

            <button class="tab-btn" role="tab" aria-selected="false" data-tab="linkedin" id="tab-linkedin">
              <svg viewBox="0 0 20 20" class="tab-icon" aria-hidden="true">
                <rect x="3" y="3" width="14" height="14" rx="2" stroke="currentColor" stroke-width="2" fill="none" />
                <line x1="7" y1="8" x2="7" y2="14" stroke="currentColor" stroke-width="2" />
                <line x1="12" y1="10" x2="12" y2="14" stroke="currentColor" stroke-width="2" />
              </svg>
              <span>LinkedIn</span>
            </button>

            <button class="tab-btn" role="tab" aria-selected="false" data-tab="newsletter" id="tab-newsletter">
              <svg viewBox="0 0 20 20" class="tab-icon" aria-hidden="true">
                <path d="M 4 3 L 16 3 L 16 17 L 4 17 Z" stroke="currentColor" stroke-width="2" fill="none" />
                <line x1="7" y1="7" x2="13" y2="7" stroke="currentColor" stroke-width="1.8" />
                <line x1="7" y1="11" x2="13" y2="11" stroke="currentColor" stroke-width="1.8" />
              </svg>
              <span>Newsletter</span>
            </button>

            <button class="tab-btn" role="tab" aria-selected="false" data-tab="email" id="tab-email">
              <svg viewBox="0 0 20 20" class="tab-icon" aria-hidden="true">
                <rect x="3" y="5" width="14" height="10" rx="2" stroke="currentColor" stroke-width="2" fill="none" />
                <path d="M 3 5 L 10 11 L 17 5" stroke="currentColor" stroke-width="1.8" fill="none" />
              </svg>
              <span>Email</span>
            </button>
          </div>

          <!-- Small Draft / Tighter edit toggle -->
          <div class="edit-toggle-wrapper" id="editToggleWrapper">
            <span class="toggle-label typewriter-label">Edit:</span>
            <div class="toggle-pills" role="radiogroup" aria-label="Edit variant">
              <button class="toggle-pill active" role="radio" data-variant="standard" aria-checked="true">Standard</button>
              <button class="toggle-pill" role="radio" data-variant="tighter" aria-checked="false">Tighter</button>
            </div>
          </div>
        </div>

        <!-- MOCKUP CONTAINER -->
        <div class="mockup-display-stage">
          <div class="tape-strip" aria-hidden="true"></div>

          <!-- 1. X THREAD PANEL -->
          <div class="mockup-panel active" id="panel-x" role="tabpanel" aria-labelledby="tab-x">
            <div class="x-thread-app light-theme" id="xThreadApp">
              
              <!-- App Top Bar with tiny theme toggle -->
              <div class="x-header">
                <span class="x-brand">Post Thread</span>
                <div class="x-theme-toggle" role="group" aria-label="X theme">
                  <button class="theme-dot active" data-theme="light" title="Light" aria-label="Light theme"></button>
                  <button class="theme-dot" data-theme="dim" title="Dim" aria-label="Dim theme"></button>
                  <button class="theme-dot" data-theme="dark" title="Lights out" aria-label="Lights out theme"></button>
                </div>
              </div>

              <!-- Standard Edit Posts -->
              <div class="x-posts-stream variant-standard" id="xStreamStandard">
                {sampleData.xThread.standard.map((post, idx) => (
                  <div class="x-post-item">
                    <div class="x-post-left">
                      <div class="x-avatar">{siteConfig.creator.avatarInitial}</div>
                      {idx < sampleData.xThread.standard.length - 1 && <div class="x-connector"></div>}
                    </div>
                    <div class="x-post-right">
                      <div class="x-author-row">
                        <span class="x-name">{siteConfig.creator.name}</span>
                        <span class="x-handle">{siteConfig.creator.handle}</span>
                        <span class="x-dot">·</span>
                        <span class="x-time">2h</span>
                        {post.isHook && (
                          <span class="stamp-badge x-hook-stamp">STRONGEST HOOK</span>
                        )}
                        <span class="x-more-menu" aria-hidden="true">···</span>
                      </div>
                      <div class="x-post-text">
                        {post.text}
                      </div>
                      <div class="x-action-row">
                        <button class="x-action-btn" aria-label="Reply, 24 replies">
                          <svg viewBox="0 0 24 24" class="x-icon" aria-hidden="true"><path d="M 1.751 10 c 0 -4.42 3.584 -8 8.005 -8 h 4.366 c 4.49 0 8.129 3.64 8.129 8.13 c 0 2.96 -1.607 5.68 -4.196 7.11 l -1.604 2.53 c -0.374 0.59 -1.168 0.77 -1.761 0.4 c -0.222 -0.14 -0.387 -0.36 -0.463 -0.61 l -0.843 -2.8 c -1.18 0.44 -2.433 0.67 -3.693 0.67 c -4.42 0 -8.005 -3.58 -8.005 -8 z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
                          <span>24</span>
                        </button>
                        <button class="x-action-btn" aria-label="Repost, 182 reposts">
                          <svg viewBox="0 0 24 24" class="x-icon" aria-hidden="true"><path d="M 4.5 3.88 v 7.62 c 0 1.38 1.12 2.5 2.5 2.5 h 11.5 l -2.47 2.47 l 1.41 1.41 l 4.88 -4.88 l -4.88 -4.88 l -1.41 1.41 l 2.47 2.47 H 7 c -0.28 0 -0.5 -0.22 -0.5 -0.5 V 3.88 z M 19.5 20.12 v -7.62 c 0 -1.38 -1.12 -2.5 -2.5 -2.5 H 5.5 l 2.47 -2.47 l -1.41 -1.41 L 1.68 11 l 4.88 4.88 l 1.41 -1.41 l -2.47 -2.47 H 17 c 0.28 0 0.5 0.22 0.5 0.5 v 7.62 z" fill="currentColor"/></svg>
                          <span>182</span>
                        </button>
                        <button class="x-action-btn like-btn" aria-label="Like post, 840 likes">
                          <svg viewBox="0 0 24 24" class="x-icon heart-icon" aria-hidden="true"><path d="M 12 21.35 l -1.45 -1.32 C 5.4 15.36 2 12.28 2 8.5 C 2 5.42 4.42 3 7.5 3 c 1.74 0 3.41 0.81 4.5 2.09 C 13.09 3.81 14.76 3 16.5 3 C 19.58 3 22 5.42 22 8.5 c 0 3.78 -3.4 6.86 -8.55 11.54 z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
                          <span class="like-count">840</span>
                        </button>
                        <button class="x-action-btn" aria-label="Views, 42K views">
                          <svg viewBox="0 0 24 24" class="x-icon" aria-hidden="true"><path d="M 8.75 21 V 3 h 2 v 18 z M 18 21 V 8.5 h 2 V 21 z M 4 21 l 0.004 -10 h 2 L 6 21 z M 13.25 21 l 0.004 -14.5 h 2 L 15.25 21 z" fill="currentColor"/></svg>
                          <span>42K</span>
                        </button>
                        <button class="x-action-btn" aria-label="Bookmark">
                          <svg viewBox="0 0 24 24" class="x-icon" aria-hidden="true"><path d="M 4 4.5 C 4 3.12 5.12 2 6.5 2 h 11 C 18.88 2 20 3.12 20 4.5 v 17.06 c 0 0.83 -0.92 1.33 -1.61 0.86 L 12 17.65 l -6.39 4.77 c -0.69 0.47 -1.61 -0.03 -1.61 -0.86 V 4.5 z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
                        </button>
                        <button class="x-action-btn" aria-label="Share">
                          <svg viewBox="0 0 24 24" class="x-icon" aria-hidden="true"><path d="M 12 2.59 l 5.7 5.7 l -1.41 1.42 L 13 6.41 V 16 h -2 V 6.41 L 7.71 9.71 L 6.3 8.29 L 12 2.59 z M 21 15 v 4 c 0 1.1 -0.9 2 -2 2 H 5 c -1.1 0 -2 -0.9 -2 -2 v -4 h 2 v 4 h 14 v -4 h 2 z" fill="currentColor"/></svg>
                        </button>
                      </div>
                    </div>
                  </div>
                ))}
              </div>

              <!-- Tighter Edit Posts -->
              <div class="x-posts-stream variant-tighter" id="xStreamTighter" style="display: none;">
                {sampleData.xThread.tighter.map((post, idx) => (
                  <div class="x-post-item">
                    <div class="x-post-left">
                      <div class="x-avatar">{siteConfig.creator.avatarInitial}</div>
                      {idx < sampleData.xThread.tighter.length - 1 && <div class="x-connector"></div>}
                    </div>
                    <div class="x-post-right">
                      <div class="x-author-row">
                        <span class="x-name">{siteConfig.creator.name}</span>
                        <span class="x-handle">{siteConfig.creator.handle}</span>
                        <span class="x-dot">·</span>
                        <span class="x-time">2h</span>
                        <span class="x-more-menu" aria-hidden="true">···</span>
                      </div>
                      <div class="x-post-text">
                        {post.text}
                      </div>
                      <div class="x-action-row">
                        <button class="x-action-btn like-btn" aria-label="Like post">
                          <svg viewBox="0 0 24 24" class="x-icon heart-icon"><path d="M 12 21.35 l -1.45 -1.32 C 5.4 15.36 2 12.28 2 8.5 C 2 5.42 4.42 3 7.5 3 c 1.74 0 3.41 0.81 4.5 2.09 C 13.09 3.81 14.76 3 16.5 3 C 19.58 3 22 5.42 22 8.5 c 0 3.78 -3.4 6.86 -8.55 11.54 z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
                          <span class="like-count">840</span>
                        </button>
                      </div>
                    </div>
                  </div>
                ))}
              </div>

            </div>
          </div>

          <!-- 2. LINKEDIN PANEL -->
          <div class="mockup-panel" id="panel-linkedin" role="tabpanel" aria-labelledby="tab-linkedin">
            <div class="linkedin-feed-wrapper">
              
              <!-- Standard Variant -->
              <article class="linkedin-card" id="liStandardCard">
                <div class="li-header">
                  <div class="li-avatar">{siteConfig.creator.avatarInitial}</div>
                  <div class="li-meta">
                    <div class="li-name-row">
                      <span class="li-name">{siteConfig.creator.name}</span>
                      <span class="li-degree">· 1st</span>
                    </div>
                    <div class="li-headline">{siteConfig.creator.headline}</div>
                    <div class="li-time-row">
                      <span>1h · </span>
                      <svg viewBox="0 0 16 16" class="li-globe" aria-hidden="true"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.2" fill="none"/><ellipse cx="8" cy="8" rx="3.5" ry="7" stroke="currentColor" stroke-width="1.2" fill="none"/><line x1="1" y1="8" x2="15" y2="8" stroke="currentColor" stroke-width="1.2"/></svg>
                    </div>
                  </div>
                  <button class="li-menu-btn" aria-label="More options">···</button>
                </div>

                <div class="li-body">
                  <p class="li-hook"><strong>{sampleData.linkedIn.standard.hook}</strong></p>
                  
                  <div class="li-collapsible-content" id="liStandardMore">
                    {sampleData.linkedIn.standard.paragraphs.map((p) => (
                      <p class="li-para">{p}</p>
                    ))}
                  </div>

                  <button class="li-more-btn" id="liMoreTrigger" aria-expanded="false">...more</button>

                  <!-- Red Pen Check Note -->
                  <div class="red-pen-note">
                    [{sampleData.linkedIn.standard.checkNote}]
                  </div>
                </div>

                <div class="li-reaction-summary">
                  <div class="li-reaction-icons">
                    <span class="li-icon-circle blue">👍</span>
                    <span class="li-icon-circle red">❤️</span>
                    <span class="li-icon-circle green">👏</span>
                    <span class="li-reaction-count">1,428</span>
                  </div>
                  <span class="li-comment-count">94 comments</span>
                </div>

                <div class="li-action-bar">
                  <button class="li-action-btn"><svg viewBox="0 0 24 24" class="li-act-icon"><path d="M 2 10 h 4 v 11 H 2 z M 21.5 11.5 c 0 -0.83 -0.67 -1.5 -1.5 -1.5 h -6.31 l 0.95 -4.57 l 0.03 -0.32 c 0 -0.41 -0.17 -0.79 -0.44 -1.06 L 13.17 3 L 7.59 8.59 C 7.22 8.95 7 9.45 7 10 v 9 c 0 1.1 0.9 2 2 2 h 9 c 0.83 0 1.54 -0.5 1.84 -1.22 l 3.02 -7.05 c 0.09 -0.23 0.14 -0.47 0.14 -0.73 z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>Like</button>
                  <button class="li-action-btn"><svg viewBox="0 0 24 24" class="li-act-icon"><path d="M 20 2 H 4 c -1.1 0 -2 0.9 -2 2 v 18 l 4 -4 h 14 c 1.1 0 2 -0.9 2 -2 V 4 c 0 -1.1 -0.9 -2 -2 -2 z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>Comment</button>
                  <button class="li-action-btn"><svg viewBox="0 0 24 24" class="li-act-icon"><path d="M 4 12 v 6 h 16 v -6 M 12 3 v 12 M 7 8 l 5 -5 l 5 5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>Repost</button>
                  <button class="li-action-btn"><svg viewBox="0 0 24 24" class="li-act-icon"><path d="M 2.01 21 L 23 12 L 2.01 3 L 2 10 l 15 2 l -15 2 z" fill="currentColor"/></svg>Send</button>
                </div>
              </article>

              <!-- Tighter Variant -->
              <article class="linkedin-card" id="liTighterCard" style="display: none;">
                <div class="li-header">
                  <div class="li-avatar">{siteConfig.creator.avatarInitial}</div>
                  <div class="li-meta">
                    <div class="li-name-row">
                      <span class="li-name">{siteConfig.creator.name}</span>
                      <span class="li-degree">· 1st</span>
                    </div>
                    <div class="li-headline">{siteConfig.creator.headline}</div>
                  </div>
                </div>
                <div class="li-body">
                  <p class="li-hook"><strong>{sampleData.linkedIn.tighter.hook}</strong></p>
                  <div class="li-collapsible-content open">
                    {sampleData.linkedIn.tighter.paragraphs.map((p) => (
                      <p class="li-para">{p}</p>
                    ))}
                  </div>
                </div>
              </article>

            </div>
          </div>

          <!-- 3. NEWSLETTER PANEL (Handwritten Letter on Warm Lined Paper with Desk Accents) -->
          <div class="mockup-panel" id="panel-newsletter" role="tabpanel" aria-labelledby="tab-newsletter">
            <div class="newsletter-desk">
              
              <!-- Sticky Tag with Subject Line -->
              <div class="sticky-subject-tag">
                <span class="sticky-pin">📌</span>
                <span class="sticky-label">Subject:</span>
                <strong class="sticky-text">{sampleData.newsletter.subject}</strong>
              </div>

              <!-- Coffee Ring Stain Accent on Desk -->
              <div class="coffee-ring-accent" aria-hidden="true"></div>

              <!-- Desk Paper Clip Accent -->
              <div class="desk-paper-clip" aria-hidden="true"></div>

              <!-- Sheet 1 of 2 -->
              <article class="letter-sheet active" id="letterSheet1">
                <div class="folded-corner" aria-hidden="true"></div>
                <div class="letter-top-header">
                  <span class="letter-from-desk">From the desk of {siteConfig.creator.name}</span>
                  <span class="sheet-number">Page 1 of 2</span>
                </div>

                <div class="letter-handwritten-body">
                  {sampleData.newsletter.sheet1.map((para) => (
                    <p class="handwritten-line">{para}</p>
                  ))}
                </div>

                <div class="red-pen-note">
                  [{sampleData.newsletter.checkNote}]
                </div>

                <div class="page-turn-bar">
                  <button class="turn-page-btn" id="nextPageBtn">
                    Turn to Page 2 &rarr;
                  </button>
                </div>
              </article>

              <!-- Sheet 2 of 2 -->
              <article class="letter-sheet" id="letterSheet2" style="display: none;">
                <div class="folded-corner" aria-hidden="true"></div>
                <div class="letter-top-header">
                  <span class="letter-from-desk">From the desk of {siteConfig.creator.name}</span>
                  <span class="sheet-number">Page 2 of 2</span>
                </div>

                <div class="letter-handwritten-body">
                  {sampleData.newsletter.sheet2.map((para) => (
                    <p class="handwritten-line">{para}</p>
                  ))}
                </div>

                <div class="letter-signature-area">
                  <p class="handwritten-signoff">I will see you in the next one.</p>
                  <p class="handwritten-sig">— {siteConfig.creator.name}</p>
                </div>

                <div class="page-turn-bar">
                  <button class="turn-page-btn secondary" id="prevPageBtn">
                    &larr; Back to Page 1
                  </button>
                </div>
              </article>

              <!-- Fountain Pen Resting Beside Letter -->
              <div class="letter-pen-accent" aria-hidden="true">
                <svg viewBox="0 0 120 18" class="pen-svg">
                  <rect x="0" y="4" width="95" height="10" rx="3" fill="#1B1A17" />
                  <rect x="25" y="4" width="4" height="10" fill="#F2D95C" />
                  <polygon points="95,5 115,9 95,13" fill="#EDE3D0" stroke="#1B1A17" stroke-width="1.2" />
                  <line x1="95" y1="9" x2="110" y2="9" stroke="#1B1A17" stroke-width="1" />
                </svg>
              </div>

            </div>
          </div>

          <!-- 4. EMAIL PANEL (Generic Email Client Window) -->
          <div class="mockup-panel" id="panel-email" role="tabpanel" aria-labelledby="tab-email">
            <div class="email-window">
              
              <div class="email-window-top">
                <div class="window-dots">
                  <span class="dot red"></span>
                  <span class="dot yellow"></span>
                  <span class="dot green"></span>
                </div>
                <span class="window-title">Message</span>
              </div>

              <div class="email-envelope-body">
                <div class="email-subject-row">
                  <span class="email-subject-label">Subject:</span>
                  <span class="email-subject-text">{sampleData.email.subject}</span>
                </div>

                <div class="email-sender-row">
                  <div class="email-avatar">{siteConfig.creator.avatarInitial}</div>
                  <div class="email-sender-meta">
                    <div class="sender-name-line">
                      <strong>{siteConfig.creator.name}</strong>
                      <span class="sender-email">&lt;{siteConfig.creator.email}&gt;</span>
                    </div>
                    <div class="sender-to-line">
                      <span>to me</span>
                      <span class="email-time">9:00 AM (1 hour ago)</span>
                    </div>
                  </div>
                  <div class="email-sender-icons">
                    <svg viewBox="0 0 20 20" class="email-star-icon" aria-label="Starred"><polygon points="10,1 12,7 19,7 13,11 15,18 10,14 5,18 7,11 1,7 8,7" fill="#F2D95C" stroke="#1B1A17" stroke-width="1.2"/></svg>
                    <svg viewBox="0 0 20 20" class="email-reply-icon" aria-label="Reply"><path d="M 8 5 L 3 10 L 8 15 M 4 10 L 14 10 C 16.5 10 18 11.5 18 14" stroke="#757064" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
                  </div>
                </div>

                <div class="email-body-text">
                  <p class="email-salutation">{sampleData.email.salutation}</p>
                  <p>{sampleData.email.opener}</p>
                  <p>{sampleData.email.problem}</p>
                  
                  <div class="email-checklist">
                    {sampleData.email.whatItDoes.map((item) => (
                      <div class="email-check-item">
                        <span class="check-bullet">✓</span>
                        <span>{item}</span>
                      </div>
                    ))}
                  </div>

                  <!-- Stamp CTA Button (Stamp 2 of 2) -->
                  <div class="email-cta-box">
                    <a href="#contact" class="stamp-cta-btn">
                      {sampleData.email.buttonText}
                    </a>
                  </div>

                  <p class="email-signoff">
                    Best,<br/>
                    {siteConfig.creator.name}
                  </p>
                </div>
              </div>

            </div>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>

<style>
  .samples-section {
    padding: clamp(3.5rem, 7vw, 6rem) 0;
    border-bottom: 1px solid var(--ink-rule);
    background-color: var(--paper-bg);
  }

  .samples-header {
    text-align: center;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .samples-title {
    margin-bottom: 0.5rem;
  }

  .typewriter-disclaimer {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ink-tertiary);
  }

  .demo-layout {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }

  .transcript-paper {
    background-color: var(--paper-card);
    border: 2px solid var(--ink-primary);
    border-radius: 6px;
    padding: 1.5rem 1.25rem;
    position: relative;
    box-shadow: 4px 4px 0 var(--ink-primary);
  }

  .transcript-top {
    border-bottom: 1px solid var(--ink-rule);
    padding-bottom: 0.75rem;
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .transcript-track-label {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--ink-primary);
  }

  .transcript-lines {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .transcript-line {
    padding: 0.4rem 0.5rem;
    border-radius: 4px;
    transition: background-color 0.2s ease, border-left 0.2s ease;
    border-left: 3px solid transparent;
  }

  .transcript-line.highlighted {
    background-color: var(--highlighter-glow);
    border-left: 3px solid var(--vermilion);
  }

  .line-timestamp {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-tertiary);
    display: block;
    margin-bottom: 2px;
  }

  .line-text {
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--ink-primary);
    margin: 0;
  }

  .transcript-footer {
    border-top: 1px dashed var(--ink-rule);
    margin-top: 1.25rem;

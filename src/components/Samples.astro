<script>
  function initSamplesDemo() {
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.mockup-panel');
    const transcriptLines = document.querySelectorAll('.transcript-line');
    const editPills = document.querySelectorAll('.toggle-pill');

    function updateActiveTab(tabId) {
      tabs.forEach((b) => {
        const isActive = b.getAttribute('data-tab') === tabId;
        b.classList.toggle('active', isActive);
        b.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      panels.forEach((p) => {
        p.classList.toggle('active', p.id === 'panel-' + tabId);
      });

      transcriptLines.forEach((line) => {
        const activeFor = (line.getAttribute('data-active-for') || '').split(',');
        const isMatch = activeFor.includes(tabId);
        line.classList.toggle('highlighted', isMatch);
      });
    }

    tabs.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tabId = btn.getAttribute('data-tab');
        if (tabId) updateActiveTab(tabId);
      });
    });

    updateActiveTab('x');

    editPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        editPills.forEach((p) => {
          p.classList.remove('active');
          p.setAttribute('aria-checked', 'false');
        });
        pill.classList.add('active');
        pill.setAttribute('aria-checked', 'true');

        const variant = pill.getAttribute('data-variant');
        const xStandard = document.getElementById('xStreamStandard');
        const xTighter = document.getElementById('xStreamTighter');
        const liStandard = document.getElementById('liStandardCard');
        const liTighter = document.getElementById('liTighterCard');

        if (variant === 'tighter') {
          if (xStandard) xStandard.style.display = 'none';
          if (xTighter) xTighter.style.display = 'block';
          if (liStandard) liStandard.style.display = 'none';
          if (liTighter) liTighter.style.display = 'block';
        } else {
          if (xStandard) xStandard.style.display = 'block';
          if (xTighter) xTighter.style.display = 'none';
          if (liStandard) liStandard.style.display = 'block';
          if (liTighter) liTighter.style.display = 'none';
        }
      });
    });

    const likeBtns = document.querySelectorAll('.like-btn');
    likeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        btn.classList.toggle('liked');
        const countSpan = btn.querySelector('.like-count');
        if (countSpan) {
          let count = parseInt(countSpan.textContent || '840', 10);
          if (btn.classList.contains('liked')) {
            countSpan.textContent = String(count + 1);
          } else {
            countSpan.textContent = String(count - 1);
          }
        }
      });
    });

    const themeDots = document.querySelectorAll('.theme-dot');
    const xApp = document.getElementById('xThreadApp');
    themeDots.forEach((dot) => {
      dot.addEventListener('click', () => {
        themeDots.forEach((d) => d.classList.remove('active'));
        dot.classList.add('active');
        const theme = dot.getAttribute('data-theme');
        if (xApp) {
          xApp.className = 'x-thread-app ' + theme + '-theme';
        }
      });
    });

    const liMoreBtn = document.getElementById('liMoreTrigger');
    const liContent = document.getElementById('liStandardMore');
    if (liMoreBtn && liContent) {
      liMoreBtn.addEventListener('click', () => {
        liContent.classList.add('open');
        liMoreBtn.style.display = 'none';
      });
    }

    const nextBtn = document.getElementById('nextPageBtn');
    const prevBtn = document.getElementById('prevPageBtn');
    const sheet1 = document.getElementById('letterSheet1');
    const sheet2 = document.getElementById('letterSheet2');

    if (nextBtn && sheet1 && sheet2) {
      nextBtn.addEventListener('click', () => {
        sheet1.style.display = 'none';
        sheet2.style.display = 'block';
      });
    }
    if (prevBtn && sheet1 && sheet2) {
      prevBtn.addEventListener('click', () => {
        sheet2.style.display = 'none';
        sheet1.style.display = 'block';
      });
    }
  }

  if (document.readyState === 'loading') {

---
import { heroData } from '../data/siteData.js';
---

<section class="hero-section" id="hero" aria-labelledby="hero-heading">
  <div class="container hero-container">
    
    <!-- Hero Copy: Minimal, < 25 words, H1 6 words max -->
    <div class="hero-copy">
      <h1 id="hero-heading" class="hero-title">
        build to keep you <span class="ink-underline">moving.</span>
      </h1>
      <p class="hero-subhead">
        {heroData.subhead}
      </p>
      <div class="hero-actions">
        <a href="#samples" class="btn-primary">
          {heroData.ctaPrimary}
        </a>
        <a href="#contact" class="btn-secondary">
          {heroData.ctaSecondary} &rarr;
        </a>
      </div>
    </div>

    <!-- Hero Illustration: Original Two-Colour Riso Linocut SVG (≥60% visual presence) -->
    <!-- ONE VIDEO IN, MANY PAGES OUT: Film reel/play frame -> press/scissors -> 4 paper pieces on desk with pen, coffee ring, clips -->
    <div class="hero-art-wrapper">
      <svg class="hero-illustration" viewBox="0 0 860 480" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="hero-art-title">
        <title id="hero-art-title">One finance video unspooling into threads, posts, a newsletter, and an email</title>
        <defs>
          <!-- Subtle Halftone Pattern -->
          <pattern id="riso-halftone" width="8" height="8" patternUnits="userSpaceOnUse">
            <circle cx="2" cy="2" r="1.1" fill="#D9381E" fill-opacity="0.32" />
          </pattern>
          <pattern id="ink-dots" width="10" height="10" patternUnits="userSpaceOnUse">
            <circle cx="3" cy="3" r="1" fill="#1B1A17" fill-opacity="0.18" />
          </pattern>
          <!-- Soft Paper Drop Filter -->
          <filter id="paper-drop" x="-6%" y="-6%" width="112%" height="116%" filterUnits="userSpaceOnUse">
            <feDropShadow dx="2" dy="5" stdDeviation="4" flood-color="#1B1A17" flood-opacity="0.1" />
          </filter>
        </defs>

        <!-- Desk Surface Line & Coffee Ring -->
        <g class="art-desk-accents">
          <!-- Coffee Ring Stain -->
          <circle cx="780" cy="110" r="42" stroke="#B87B4C" stroke-width="2.5" stroke-dasharray="8 3 14 4" stroke-opacity="0.25" fill="#FAF6EE" fill-opacity="0.08" />
          <circle cx="778" cy="108" r="38" stroke="#B87B4C" stroke-width="1.2" stroke-opacity="0.18" fill="none" />
          
          <!-- Desk baseline -->
          <path d="M 30 430 L 830 430" stroke="#1B1A17" stroke-width="1.5" stroke-dasharray="4 4" stroke-opacity="0.3" />
        </g>

        <!-- 1. VIDEO REEL / CASSETTE (Left: Video In) -->
        <g class="art-video-in" transform="translate(40, 90)">
          <!-- Riso Red Misregistered Shadow -->
          <rect x="2" y="4" width="168" height="190" rx="8" fill="#D9381E" fill-opacity="0.18" transform="rotate(-1.5 84 95)" />
          
          <!-- Black Ink Main Cassette -->
          <rect x="0" y="0" width="168" height="190" rx="8" fill="#FAF6EE" stroke="#1B1A17" stroke-width="3" filter="url(#paper-drop)" />
          
          <!-- Cassette Window -->
          <rect x="18" y="24" width="132" height="74" rx="4" fill="#EDE3D0" stroke="#1B1A17" stroke-width="2" />
          
          <!-- Film Spools inside window -->
          <circle cx="50" cy="61" r="20" stroke="#1B1A17" stroke-width="2.5" fill="#FAF6EE" />
          <circle cx="50" cy="61" r="7" fill="#1B1A17" />
          <circle cx="118" cy="61" r="20" stroke="#1B1A17" stroke-width="2.5" fill="#FAF6EE" />
          <circle cx="118" cy="61" r="7" fill="#1B1A17" />
          
          <!-- Connecting film loop inside window -->
          <path d="M 50 41 Q 84 48 118 41" stroke="#1B1A17" stroke-width="2.2" />

          <!-- Large Play Triangle Symbol (Riso Red with slight offset) -->
          <polygon points="76,128 76,164 106,146" fill="#D9381E" stroke="#1B1A17" stroke-width="2.5" stroke-linejoin="round" />

          <!-- Cassette Label -->
          <text x="84" y="180" font-family="'Courier Prime', monospace" font-size="10" font-weight="700" fill="#1B1A17" text-anchor="middle" letter-spacing="1">YOUTUBE VIDEO</text>
        </g>

        <!-- 2. UNSPOOLING FILM RIBBON (Moving from Left to Center) -->
        <g class="art-film-ribbon">
          <!-- Misregistered Red Trace -->
          <path class="ribbon-red-track" d="M 208 190 C 260 190, 290 240, 360 238 S 430 195, 480 205" stroke="#D9381E" stroke-width="14" stroke-linecap="round" fill="none" opacity="0.4" />
          
          <!-- Main Film Strip (Black with Sprocket Holes) -->
          <path class="ribbon-black-track" d="M 206 188 C 258 188, 288 238, 358 236 S 428 193, 478 203" stroke="#1B1A17" stroke-width="12" stroke-linecap="round" fill="none" />
          
          <!-- Sprocket dots along the film ribbon -->
          <circle cx="230" cy="189" r="2" fill="#FAF6EE" />
          <circle cx="260" cy="204" r="2" fill="#FAF6EE" />
          <circle cx="295" cy="227" r="2" fill="#FAF6EE" />
          <circle cx="330" cy="237" r="2" fill="#FAF6EE" />
          <circle cx="365" cy="235" r="2" fill="#FAF6EE" />
          <circle cx="400" cy="216" r="2" fill="#FAF6EE" />
          <circle cx="435" cy="198" r="2" fill="#FAF6EE" />
          <circle cx="470" cy="202" r="2" fill="#FAF6EE" />
        </g>

        <!-- 3. HAND-DRAWN EDITORIAL PRESS & SCISSORS (Center Converter) -->
        <g class="art-converter-press" transform="translate(370, 160)">
          <!-- Scissors Graphic -->
          <!-- Handle 1 -->
          <circle cx="40" cy="22" r="14" stroke="#1B1A17" stroke-width="2.5" fill="#FAF6EE" />
          <!-- Handle 2 -->
          <circle cx="40" cy="68" r="14" stroke="#1B1A17" stroke-width="2.5" fill="#FAF6EE" />
          <!-- Blades meeting at pivot -->
          <path d="M 49 30 L 98 52" stroke="#1B1A17" stroke-width="3" stroke-linecap="round" />
          <path d="M 49 60 L 98 38" stroke="#1B1A17" stroke-width="3" stroke-linecap="round" />
          <!-- Pivot screw -->
          <circle cx="70" cy="45" r="3.5" fill="#D9381E" stroke="#1B1A17" stroke-width="1.5" />

          <!-- Tiny Yellow Highlighter Sparkles -->
          <path d="M 106 32 L 112 36 L 106 40 L 100 36 Z" fill="#F2D95C" />
          <path d="M 112 55 L 116 58 L 112 61 L 108 58 Z" fill="#F2D95C" />
        </g>

        <!-- 4. FOUR SPLITTING STREAMS TO OUTPUT OBJECTS (Right Side) -->
        <!-- Splitting Guide Curves -->
        <path d="M 480 205 Q 520 130 550 110" stroke="#1B1A17" stroke-width="2" stroke-dasharray="3 3" opacity="0.6" />
        <path d="M 480 205 Q 530 190 560 195" stroke="#1B1A17" stroke-width="2" stroke-dasharray="3 3" opacity="0.6" />
        <path d="M 480 205 Q 520 270 550 300" stroke="#1B1A17" stroke-width="2" stroke-dasharray="3 3" opacity="0.6" />
        <path d="M 480 205 Q 520 350 560 380" stroke="#1B1A17" stroke-width="2" stroke-dasharray="3 3" opacity="0.6" />

        <!-- OUTPUT 1: X THREAD CARD (Speech Bubble Card with 1/) -->
        <g class="art-piece art-piece-x" transform="translate(545, 50)">
          <!-- Washi tape at angle -->
          <rect x="50" y="-8" width="45" height="15" fill="#EEE6CE" stroke="#C3B796" stroke-width="1" transform="rotate(-3 50 -8)" />
          
          <!-- Riso Red layer -->
          <rect x="3" y="3" width="150" height="96" rx="6" fill="#D9381E" fill-opacity="0.15" />
          <!-- Main Card -->
          <rect x="0" y="0" width="150" height="96" rx="6" fill="#FAF6EE" stroke="#1B1A17" stroke-width="2.4" filter="url(#paper-drop)" />
          
          <!-- Speech pointer -->
          <path d="M 22 96 L 15 110 L 32 96 Z" fill="#FAF6EE" stroke="#1B1A17" stroke-width="2.4" stroke-linejoin="round" />
          
          <!-- Card Content: 1/ Thread hook -->
          <circle cx="24" cy="26" r="10" fill="#1B1A17" />
          <text x="24" y="30" font-family="'Courier Prime', monospace" font-size="11" font-weight="700" fill="#FAF6EE" text-anchor="middle">1/</text>
          
          <!-- Text lines -->
          <rect x="42" y="22" width="70" height="7" rx="2" fill="#1B1A17" />
          <!-- Highlighted sentence -->
          <rect x="20" y="46" width="112" height="9" rx="2" fill="#F2D95C" />
          <rect x="20" y="62" width="95" height="6" rx="2" fill="#757064" />
          <rect x="20" y="74" width="65" height="6" rx="2" fill="#A8A294" />

          <!-- Tiny Label -->
          <text x="140" y="18" font-family="'Courier Prime', monospace" font-size="8" font-weight="700" fill="#D9381E" text-anchor="end">X THREAD</text>
        </g>

        <!-- OUTPUT 2: LINKEDIN POST CARD (Framed Post) -->
        <g class="art-piece art-piece-li" transform="translate(680, 140)">
          <!-- Riso Red shadow -->
          <rect x="-2" y="4" width="155" height="110" rx="4" fill="#D9381E" fill-opacity="0.2" transform="rotate(2)" />
          <!-- Main Card -->
          <rect x="0" y="0" width="155" height="110" rx="4" fill="#FFFFFF" stroke="#1B1A17" stroke-width="2.4" filter="url(#paper-drop)" />
          
          <!-- Author row -->
          <circle cx="22" cy="22" r="9" fill="#0A66C2" />
          <text x="22" y="26" font-family="'Courier Prime', monospace" font-size="9" font-weight="700" fill="#FFFFFF" text-anchor="middle">in</text>
          <rect x="38" y="16" width="60" height="6" rx="1" fill="#1B1A17" />
          <rect x="38" y="25" width="40" height="4" rx="1" fill="#757064" />

          <!-- Post body lines -->
          <rect x="14" y="42" width="128" height="6" rx="1" fill="#1B1A17" />
          <rect x="14" y="54" width="118" height="6" rx="1" fill="#1B1A17" />
          <rect x="14" y="66" width="90" height="6" rx="1" fill="#1B1A17" />

          <!-- Reaction row -->
          <circle cx="22" cy="94" r="5" fill="#0A66C2" />
          <circle cx="31" cy="94" r="5" fill="#D9381E" />
          <rect x="42" y="91" width="35" height="5" rx="1" fill="#757064" />

          <!-- Label -->
          <text x="145" y="16" font-family="'Courier Prime', monospace" font-size="8" font-weight="700" fill="#1B1A17" text-anchor="end">LINKEDIN</text>
        </g>

        <!-- OUTPUT 3: NEWSLETTER (Folded Handwritten Letter) -->
        <g class="art-piece art-piece-news" transform="translate(535, 220)">
          <!-- Riso Misregistration -->
          <rect x="4" y="4" width="145" height="135" rx="2" fill="#D9381E" fill-opacity="0.16" transform="rotate(-1)" />
          <!-- Letter Paper -->
          <rect x="0" y="0" width="145" height="135" rx="2" fill="#FAF6EE" stroke="#1B1A17" stroke-width="2.4" filter="url(#paper-drop)" />
          
          <!-- Ruled lines on paper -->
          <line x1="12" y1="36" x2="133" y2="36" stroke="#1B1A17" stroke-opacity="0.12" stroke-width="1" />
          <line x1="12" y1="56" x2="133" y2="56" stroke="#1B1A17" stroke-opacity="0.12" stroke-width="1" />
          <line x1="12" y1="76" x2="133" y2="76" stroke="#1B1A17" stroke-opacity="0.12" stroke-width="1" />
          <line x1="12" y1="96" x2="133" y2="96" stroke="#1B1A17" stroke-opacity="0.12" stroke-width="1" />
          <line x1="12" y1="116" x2="133" y2="116" stroke="#1B1A17" stroke-opacity="0.12" stroke-width="1" />

          <!-- Handwritten style wave lines -->
          <path d="M 16 26 Q 40 23 80 27" stroke="#1B1A17" stroke-width="2" fill="none" stroke-linecap="round" />
          <path d="M 16 48 Q 50 44 110 50" stroke="#1B1A17" stroke-width="1.8" fill="none" stroke-linecap="round" />
          <path d="M 16 68 Q 60 72 125 67" stroke="#1B1A17" stroke-width="1.8" fill="none" stroke-linecap="round" />
          <!-- Yellow highlight on key line -->
          <rect x="14" y="84" width="90" height="9" fill="#F2D95C" fill-opacity="0.8" rx="2" />
          <path d="M 16 88 Q 55 85 100 89" stroke="#1B1A17" stroke-width="1.8" fill="none" stroke-linecap="round" />
          
          <!-- Folded Corner Effect -->
          <path d="M 125 0 L 145 20 L 125 20 Z" fill="#EDE3D0" stroke="#1B1A17" stroke-width="2" />

          <!-- Paper clip -->
          <path d="M 28 -6 L 28 18 Q 28 24 34 24 Q 40 24 40 18 L 40 -2" stroke="#757064" stroke-width="2.2" fill="none" stroke-linecap="round" />

          <!-- Label -->
          <text x="135" y="126" font-family="'Courier Prime', monospace" font-size="8" font-weight="700" fill="#D9381E" text-anchor="end">NEWSLETTER</text>
        </g>

        <!-- OUTPUT 4: EMAIL LETTER (Envelope with Small Stamp) -->
        <g class="art-piece art-piece-email" transform="translate(685, 290)">
          <!-- Riso offset -->
          <rect x="-3" y="3" width="145" height="98" rx="4" fill="#D9381E" fill-opacity="0.18" />
          <!-- Envelope Body -->
          <rect x="0" y="0" width="145" height="98" rx="4" fill="#FAF6EE" stroke="#1B1A17" stroke-width="2.4" filter="url(#paper-drop)" />
          
          <!-- Envelope Flap Lines -->
          <path d="M 0 0 L 72 52 L 145 0" stroke="#1B1A17" stroke-width="2.2" fill="#FCF9F2" />
          <line x1="0" y1="98" x2="52" y2="42" stroke="#1B1A17" stroke-width="1.5" stroke-opacity="0.3" />
          <line x1="145" y1="98" x2="93" y2="42" stroke="#1B1A17" stroke-width="1.5" stroke-opacity="0.3" />

          <!-- Small Postage Stamp (Red Riso with Serrated Edges) -->
          <rect x="108" y="10" width="26" height="30" fill="#D9381E" stroke="#1B1A17" stroke-width="1.8" stroke-dasharray="3 2" />
          <circle cx="121" cy="25" r="5" fill="#FAF6EE" />

          <!-- Address / Subject lines -->
          <rect x="16" y="58" width="65" height="5" rx="1" fill="#1B1A17" />
          <rect x="16" y="70" width="90" height="5" rx="1" fill="#757064" />
          <rect x="16" y="81" width="45" height="4" rx="1" fill="#A8A294" />

          <!-- Label -->
          <text x="135" y="90" font-family="'Courier Prime', monospace" font-size="8" font-weight="700" fill="#1B1A17" text-anchor="end">EMAIL</text>
        </g>

        <!-- Fountain Pen Resting on Desk -->
        <g class="art-pen" transform="translate(650, 405) rotate(-15)">
          <!-- Pen Body -->
          <rect x="0" y="0" width="120" height="10" rx="3" fill="#1B1A17" />
          <!-- Golden/Brass Trim -->
          <rect x="25" y="0" width="4" height="10" fill="#F2D95C" />
          <!-- Nib -->
          <polygon points="120,1 138,5 120,9" fill="#EDE3D0" stroke="#1B1A17" stroke-width="1.2" />
          <!-- Nib slit -->
          <line x1="120" y1="5" x2="133" y2="5" stroke="#1B1A17" stroke-width="1" />
        </g>
      </svg>
    </div>

  </div>
</section>

<style>
  .hero-section {
    min-height: calc(100vh - 72px);
    display: flex;
    align-items: center;
    padding: clamp(2rem, 5vw, 4rem) 0;
    position: relative;
    border-bottom: 1px solid var(--ink-rule);
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 4rem);
    width: 100%;
  }

  .hero-copy {
    max-width: 780px;
  }

  .hero-title {
    margin-bottom: 1rem;
    color: var(--ink-primary);
  }

  .hero-subhead {
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
    line-height: 1.45;
    color: var(--ink-secondary);
    margin-bottom: 2rem;
    max-width: 650px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  /* Art Container takes >= 60% visual scale */
  .hero-art-wrapper {
    width: 100%;
    background-color: var(--paper-desk);
    border: 2px solid var(--ink-primary);
    border-radius: 8px;
    padding: clamp(1rem, 3vw, 2rem);
    box-shadow: 6px 6px 0 var(--ink-primary);
    position: relative;
    overflow: hidden;
  }

  .hero-illustration {
    width: 100%;
    height: auto;
    display: block;
    max-height: 520px;
  }

  /* Animation: ribbon stroke drawing */
  .ribbon-black-track, .ribbon-red-track {
    stroke-dasharray: 600;
    stroke-dashoffset: 0;
    animation: drawRibbon 2.2s cubic-bezier(0.16, 1, 0.3, 1) forwards 0.2s;
  }

  
  .art-piece {
    opacity: 1;
  }

  @keyframes drawRibbon {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .ribbon-black-track, .ribbon-red-track {
      animation: none;
    }
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 2rem 0;
    }
    .hero-actions {
      gap: 1rem;
    }
  }

  @media (max-width: 480px) {
    .hero-title {
      font-size: 1.85rem;
      line-height: 1.18;
    }
    .hero-subhead {
      font-size: 1.05rem;
    }
    .hero-art-wrapper {
      padding: 0.75rem;
    }
  }
</style>

---
import { siteConfig } from '../data/siteData.js';
---

<header class="site-header" role="banner">
  <div class="container header-inner">
    <a href="#" class="brand-wordmark" aria-label="Steadure Home">
      <span class="wordmark-text">{siteConfig.brand.name}</span>
      <span class="wordmark-dot">.</span>
    </a>

    <a href="#contact" class="btn-primary nav-btn">
      Send a video
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(244, 239, 230, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--ink-rule);
    transition: background-color 0.2s ease;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .brand-wordmark {
    text-decoration: none;
    display: inline-flex;
    align-items: baseline;
    color: var(--ink-primary);
  }

  .wordmark-text {
    font-family: var(--font-serif);
    font-size: 1.85rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .wordmark-dot {
    font-family: var(--font-serif);
    font-size: 1.85rem;
    color: var(--vermilion);
    margin-left: 1px;
  }

  .nav-btn {
    padding: 9px 20px;
    font-size: 0.88rem;
  }

  @media (max-width: 480px) {
    .header-inner {
      height: 58px;
    }
    .wordmark-text {
      font-size: 1.4rem;
    }
    .wordmark-dot {
      font-size: 1.4rem;
    }
    .nav-btn {
      padding: 6px 12px;
      font-size: 0.78rem;
    }
  }
</style>

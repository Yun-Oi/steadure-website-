---
---

<section id="the-pack" class="pack-section">
  <div class="container-zine">
    <!-- Header -->
    <div class="pack-header-row">
      <div class="header-stamp-wrap">
        <span class="stamp-badge">05 // THE CONTENT PACK</span>
        <span class="type-mono-sm">PHYSICAL DELIVERABLES MANIFEST</span>
      </div>
      <h2 class="pack-title type-punch-lg">WHAT ARRIVES IN YOUR DOCKET</h2>
      <p class="pack-subhead type-serif-body">
        Everything you need to dominate text feeds for 7 to 10 days, distilled from a single recording session.
      </p>
    </div>

    <!-- Physical Manila Folder Container -->
    <div class="folder-container">
      <!-- Folder Tab Top -->
      <div class="folder-tab-bar">
        <div class="folder-tab-active">
          <span class="folder-icon">🗂</span>
          <span class="type-punch-md">CONTENT PACK // DISPATCH #01</span>
          <span class="stamp-badge">CONFIDENTIAL</span>
        </div>
        <div class="folder-tab-meta type-mono-sm">
          <span>TURNAROUND: 48 HOURS // FORMAT: NOTION DOCKET + RAW MARKDOWN</span>
        </div>
      </div>

      <!-- Main Folder Pocket with Spilling Sheets -->
      <div class="folder-pocket-body card-elevated">
        <!-- Marker Note 1: Tape Pinned -->
        <div class="pinned-marker-note note-voice">
          <div class="tape-strip tape-top-center"></div>
          <span class="marker-pencil-icon">✎</span>
          <span class="note-text type-handwriting">written in your voice</span>
        </div>

        <!-- Marker Note 2: Red Ink Stamp -->
        <div class="pinned-marker-note note-claims">
          <div class="stamp-badge-large">
            HOOKS MARKED, CLAIMS FLAGGED TO VERIFY
          </div>
        </div>

        <!-- The Deliverables Spilling Out -->
        <div class="deliverables-stack-grid">
          <!-- Sheet 1: X Threads -->
          <div class="deliverable-sheet sheet-1 card-raw">
            <div class="sheet-pin-bar">
              <span class="sheet-num type-mono-sm">01 / DELIVERABLE</span>
              <span class="stamp-badge">X (TWITTER) PACK</span>
            </div>
            <h3 class="sheet-title type-punch-md">2-3 X Posts & Threads</h3>
            <p class="sheet-desc type-serif-body">
              Multiple hook angles tested against reader psychology. Hook 1 for controversy/stat, Hook 2 for personal story, Hook 3 for contrarian framework.
            </p>
            <ul class="sheet-bullets type-mono-sm">
              <li>✓ Character count tuned for algorithmic retention</li>
              <li>✓ Ready-to-copy numbering (1/N, 2/N)</li>
              <li>✓ Pinned bookmark CTA</li>
            </ul>
          </div>

          <!-- Sheet 2: LinkedIn -->
          <div class="deliverable-sheet sheet-2 card-raw">
            <div class="sheet-pin-bar">
              <span class="sheet-num type-mono-sm">02 / DELIVERABLE</span>
              <span class="stamp-badge-green">LINKEDIN ASSET</span>
            </div>
            <h3 class="sheet-title type-punch-md">1 Thought-Leadership Post</h3>
            <p class="sheet-desc type-serif-body">
              Engineered for the senior professional and investor demographic. Storytelling arc that establishes undeniable category authority.
            </p>
            <ul class="sheet-bullets type-mono-sm">
              <li>✓ Breathable whitespace formatting</li>
              <li>✓ High-intent comment prompt</li>
              <li>✓ Zero corporate jargon or platitudes</li>
            </ul>
          </div>

          <!-- Sheet 3: Newsletter -->
          <div class="deliverable-sheet sheet-3 card-raw">
            <div class="sheet-pin-bar">
              <span class="sheet-num type-mono-sm">03 / DELIVERABLE</span>
              <span class="stamp-badge">NEWSLETTER DISPATCH</span>
            </div>
            <h3 class="sheet-title type-punch-md">1 Editorial Newsletter</h3>
            <p class="sheet-desc type-serif-body">
              A 3-minute executive brief ready for your Substack, Beehiiv, or Kit broadcast. Includes tested subject line variants and preview text.
            </p>
            <ul class="sheet-bullets type-mono-sm">
              <li>✓ 3 A/B test subject lines</li>
              <li>✓ Structured takeaways for scannability</li>
              <li>✓ Clear editorial thesis</li>
            </ul>
          </div>

          <!-- Sheet 4: Email Letter -->
          <div class="deliverable-sheet sheet-4 card-raw">
            <div class="sheet-pin-bar">
              <span class="sheet-num type-mono-sm">04 / DELIVERABLE</span>
              <span class="stamp-badge">DIRECT LETTER</span>
            </div>
            <h3 class="sheet-title type-punch-md">1 Intimate Email Letter</h3>
            <p class="sheet-desc type-serif-body">
              A conversational, first-person note designed to trigger direct replies from your audience and build deep individual loyalty.
            </p>
            <ul class="sheet-bullets type-mono-sm">
              <li>✓ High primary-tab inbox placement</li>
              <li>✓ Conversational hook</li>
              <li>✓ Single focused action link</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pack-section {
    padding-top: var(--sp-6);
    padding-bottom: var(--sp-7);
    background-color: var(--paper-base);
    border-bottom: var(--border-thick);
  }

  .pack-header-row {
    margin-bottom: var(--sp-5);
  }

  .header-stamp-wrap {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-bottom: var(--sp-2);
  }

  .pack-title {
    margin-bottom: var(--sp-2);
  }

  .pack-subhead {
    max-width: 680px;
    color: var(--ink-secondary);
  }

  /* Folder Container */
  .folder-container {
    position: relative;
    margin-top: var(--sp-5);
  }

  .folder-tab-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: -3px;
    position: relative;
    z-index: 5;
    flex-wrap: wrap;
    gap: 8px;
  }

  .folder-tab-active {
    background-color: var(--paper-sheet);
    border: var(--border-heavy);
    border-bottom: none;
    padding: 10px 24px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .folder-icon {
    font-size: 1.2rem;
  }

  .folder-tab-meta {
    padding: 8px 16px;
    background-color: var(--ink-black);
    color: var(--paper-sheet);
    font-weight: 700;
  }

  .folder-pocket-body {
    background-color: var(--paper-sunken);
    border: var(--border-heavy);
    padding: clamp(24px, 4vw, 48px);
    position: relative;
  }

  /* Taped Marker Notes */
  .pinned-marker-note {
    position: absolute;
    z-index: 15;
    pointer-events: none;
  }

  .note-voice {
    top: -24px;
    right: 40px;
    background-color: #FFF9D2;
    border: 2px solid var(--ink-black);
    padding: 8px 20px;
    transform: rotate(2.5deg);
    display: flex;
    align-items: center;
    gap: 6px;
    box-shadow: 2px 3px 0 rgba(0,0,0,0.15);
  }

  .marker-pencil-icon {
    color: var(--accent-vermilion);
    font-size: 1rem;
  }

  .note-text {
    font-size: 1.5rem;
    color: var(--ink-black);
  }

  .note-claims {
    bottom: -18px;
    left: 40px;
    transform: rotate(-1.5deg);
  }

  .stamp-badge-large {
    display: inline-block;
    font-family: var(--font-headline-punch);
    font-size: 0.8rem;
    color: var(--accent-vermilion);
    border: 3px solid var(--accent-vermilion);
    background-color: var(--paper-sheet);
    padding: 6px 14px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  /* Deliverables Grid */
  .deliverables-stack-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-4);
    margin-top: var(--sp-3);
    margin-bottom: var(--sp-3);
  }

  @media (min-width: 768px) {
    .deliverables-stack-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .deliverable-sheet {
    background-color: var(--paper-sheet);
    border: var(--border-thick);
    padding: var(--sp-4);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .deliverable-sheet:hover {
    transform: translateY(-4px);
    border-color: var(--accent-vermilion);
  }

  .sheet-1 { transform: rotate(-0.5deg); }
  .sheet-2 { transform: rotate(0.6deg); }
  .sheet-3 { transform: rotate(0.4deg); }
  .sheet-4 { transform: rotate(-0.4deg); }

  .sheet-pin-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px dashed var(--ink-faint);
    padding-bottom: 6px;
    margin-bottom: 10px;
  }

  .sheet-num {
    color: var(--ink-muted);
  }

  .sheet-title {
    margin-bottom: 8px;
  }

  .sheet-desc {
    color: var(--ink-secondary);
    font-size: 1rem;
    line-height: 1.45;
    margin-bottom: 14px;
  }

  .sheet-bullets {
    list-style: none;
    border-top: 1px solid var(--paper-dark);
    padding-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--ink-muted);
  }
</style>

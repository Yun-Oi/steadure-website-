---
import { howItWorksData } from '../data/siteData.js';
---

<section class="storyboard-section" id="how-it-works" aria-labelledby="storyboard-heading">
  <div class="container">
    
    <div class="section-header">
      <h2 id="storyboard-heading" class="section-title">
        {howItWorksData.title}
      </h2>
    </div>

    <!-- 3-Panel Illustrated Storyboard (Comic Panel Style) -->
    <!-- Max 3 words under each panel: "Send the link", "We write it", "You post it" -->
    <div class="storyboard-grid">
      
      <!-- Panel 1: Send the link -->
      <div class="comic-panel">
        <div class="panel-tag typewriter-label">01</div>
        <div class="panel-art" aria-hidden="true">
          <svg viewBox="0 0 240 180" class="panel-svg">
            <!-- Riso Red Offset -->
            <rect x="24" y="24" width="180" height="120" rx="6" fill="#D9381E" fill-opacity="0.18" />
            <!-- Main Cassette / Video Card -->
            <rect x="20" y="20" width="180" height="120" rx="6" fill="#FAF6EE" stroke="#1B1A17" stroke-width="2.4" />
            
            <!-- Video film reels -->
            <circle cx="70" cy="70" r="26" stroke="#1B1A17" stroke-width="2.2" fill="#EDE3D0" />
            <circle cx="70" cy="70" r="9" fill="#1B1A17" />
            <circle cx="150" cy="70" r="26" stroke="#1B1A17" stroke-width="2.2" fill="#EDE3D0" />
            <circle cx="150" cy="70" r="9" fill="#1B1A17" />
            
            <!-- Link chain icon in riso red -->
            <g transform="translate(100, 60)">
              <circle cx="10" cy="10" r="14" fill="#D9381E" fill-opacity="0.9" />
              <!-- Link symbol -->
              <path d="M 5 10 L 15 10 M 7 7 L 13 7 M 7 13 L 13 13" stroke="#FAF6EE" stroke-width="2" stroke-linecap="round" />
            </g>

            <!-- Video player bottom bar with red scrubber -->
            <line x1="34" y1="120" x2="186" y2="120" stroke="#1B1A17" stroke-width="2" opacity="0.4" />
            <line x1="34" y1="120" x2="95" y2="120" stroke="#D9381E" stroke-width="3.5" />
            <circle cx="95" cy="120" r="4" fill="#D9381E" />
          </svg>
        </div>
        <h3 class="panel-caption">Send the link</h3>
      </div>

      <!-- Arrow Divider (Original SVG) -->
      <div class="panel-arrow" aria-hidden="true">
        <svg viewBox="0 0 40 24" class="arrow-svg">
          <path d="M 4 12 L 32 12 M 24 4 L 32 12 L 24 20" stroke="#1B1A17" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>

      <!-- Panel 2: We write it -->
      <div class="comic-panel">
        <div class="panel-tag typewriter-label">02</div>
        <div class="panel-art" aria-hidden="true">
          <svg viewBox="0 0 240 180" class="panel-svg">
            <!-- Riso Red Offset -->
            <rect x="34" y="19" width="160" height="135" rx="3" fill="#D9381E" fill-opacity="0.18" />
            <!-- Manuscript Sheet -->
            <rect x="30" y="15" width="160" height="135" rx="3" fill="#FAF6EE" stroke="#1B1A17" stroke-width="2.4" />
            
            <!-- Ruled text lines -->
            <line x1="45" y1="38" x2="175" y2="38" stroke="#1B1A17" stroke-width="2.2" />
            <line x1="45" y1="56" x2="160" y2="56" stroke="#1B1A17" stroke-width="1.8" />
            
            <!-- Yellow Highlighter across key line -->
            <rect x="42" y="70" width="138" height="14" fill="#F2D95C" fill-opacity="0.85" rx="2" />
            <line x1="45" y1="77" x2="175" y2="77" stroke="#1B1A17" stroke-width="2.2" />
            
            <line x1="45" y1="98" x2="145" y2="98" stroke="#1B1A17" stroke-width="1.8" />
            <line x1="45" y1="116" x2="165" y2="116" stroke="#1B1A17" stroke-width="1.8" />
            <line x1="45" y1="134" x2="110" y2="134" stroke="#1B1A17" stroke-width="1.8" />

            <!-- Red Editorial Pen Annotation -->
            <path d="M 160 30 Q 185 35 180 50 Q 175 60 165 65" stroke="#D9381E" stroke-width="2" fill="none" stroke-linecap="round" />
            <circle cx="165" cy="65" r="2.5" fill="#D9381E" />
          </svg>
        </div>
        <h3 class="panel-caption">We write it</h3>
      </div>

      <!-- Arrow Divider (Original SVG) -->
      <div class="panel-arrow" aria-hidden="true">
        <svg viewBox="0 0 40 24" class="arrow-svg">
          <path d="M 4 12 L 32 12 M 24 4 L 32 12 L 24 20" stroke="#1B1A17" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>

      <!-- Panel 3: You post it -->
      <div class="comic-panel">
        <div class="panel-tag typewriter-label">03</div>
        <div class="panel-art" aria-hidden="true">
          <svg viewBox="0 0 240 180" class="panel-svg">
            <!-- Four Stacked Ready Pieces with slight fanning -->
            <!-- Back card (Email) -->
            <rect x="50" y="22" width="130" height="95" rx="4" fill="#EDE3D0" stroke="#1B1A17" stroke-width="1.8" transform="rotate(-6 115 69)" />
            <!-- Middle card (Newsletter) -->
            <rect x="52" y="24" width="130" height="95" rx="4" fill="#F4EFE6" stroke="#1B1A17" stroke-width="2" transform="rotate(4 117 71)" />
            
            <!-- Front Card (Ready Post with Washi tape & Red Checkmark) -->
            <rect x="54" y="26" width="132" height="95" rx="4" fill="#FAF6EE" stroke="#1B1A17" stroke-width="2.4" />
            
            <!-- Washi tape at top -->
            <rect x="95" y="18" width="50" height="15" fill="#EEE6CE" stroke="#C3B796" stroke-width="1" />
            
            <!-- Lines on front card -->
            <rect x="68" y="44" width="60" height="6" rx="1" fill="#1B1A17" />
            <rect x="68" y="58" width="102" height="5" rx="1" fill="#757064" />
            <rect x="68" y="70" width="85" height="5" rx="1" fill="#757064" />
            <rect x="68" y="82" width="95" height="5" rx="1" fill="#757064" />

            <!-- Large Red Riso Checkmark Circle -->
            <circle cx="160" cy="100" r="18" fill="#D9381E" />
            <path d="M 152 100 L 158 106 L 170 93" stroke="#FAF6EE" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none" />
          </svg>
        </div>
        <h3 class="panel-caption">You post it</h3>
      </div>

    </div>

  </div>
</section>

<style>
  .storyboard-section {
    padding: clamp(3.5rem, 7vw, 6rem) 0;
    border-bottom: 1px solid var(--ink-rule);
    background-color: var(--paper-bg);
  }

  .section-header {
    text-align: center;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .section-title {
    color: var(--ink-primary);
  }

  .storyboard-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    max-width: 1040px;
    margin: 0 auto;
  }

  .comic-panel {
    background-color: var(--paper-card);
    border: 2px solid var(--ink-primary);
    border-radius: 6px;
    padding: 1.5rem 1rem 1.8rem;
    text-align: center;
    box-shadow: 4px 4px 0 var(--ink-primary);
    position: relative;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .comic-panel:hover {
    transform: translateY(-4px);
    box-shadow: 6px 6px 0 var(--ink-primary);
  }

  .panel-tag {
    position: absolute;
    top: -12px;
    left: 16px;
    background-color: var(--paper-bg);
    border: 1.5px solid var(--ink-primary);
    padding: 2px 8px;
    border-radius: 3px;
    font-weight: 700;
    color: var(--ink-primary);
  }

  .panel-art {
    margin-bottom: 1.25rem;
  }

  .panel-svg {
    width: 100%;
    max-width: 220px;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  .panel-caption {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--ink-primary);
    margin: 0;
  }

  .panel-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.6;
  }

  .arrow-svg {
    width: 32px;
    height: 20px;
  }

  @media (max-width: 768px) {
    .storyboard-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
      max-width: 360px;
    }
    .panel-arrow {
      transform: rotate(90deg);
      margin: -0.5rem 0;
    }
  }
</style>
